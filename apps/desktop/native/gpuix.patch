+    #[gpui::test]
+    fn automation_tree_reads_native_text_without_editing(cx: &mut gpui::TestAppContext) {
+        use crate::renderer::GpuixView;
+        use crate::retained_tree::RetainedTree;
+        use std::collections::HashMap;
+        use std::sync::{Arc, Mutex};
+
+        for multiline in [false, true] {
+            let kind = if multiline { "textarea" } else { "input" };
+            let original = if multiline {
+                "- [ ] Call 🌿\ne\u{301}"
+            } else {
+                "Task plans Ω"
+            };
+            let edited = if multiline {
+                "- [x] Call 🌿\ne\u{301}"
+            } else {
+                "Task plans Ω copy"
+            };
+            let mut tree = RetainedTree::new();
+            let batch = serde_json::json!([
+                ["createElement", 1, "div"],
+                ["setRoot", 1],
+                ["createElement", 2, kind],
+                ["appendChild", 1, 2],
+                ["setCustomProp", 2, "testId", "note-title"],
+                ["setCustomProp", 2, "value", original],
+                ["createElement", 3, "text"],
+                ["setText", 3, "Label Ω"],
+                ["appendChild", 1, 3],
+                ["createElement", 4, kind],
+                ["appendChild", 1, 4],
+                ["setCustomProp", 4, "value", "Not mounted"]
+            ]);
+            crate::renderer::apply_batch_to_tree(&mut tree, batch.to_string().as_bytes()).unwrap();
+            let tree = Arc::new(Mutex::new(tree));
+            let input =
+                std::rc::Rc::new(std::cell::RefCell::new(TextEditorElement::new(multiline)));
+            let handle = cx.add_window(|_, _| {
+                let mut view = GpuixView::new(
+                    tree.clone(),
+                    None,
+                    "Native editor test".into(),
+                    Default::default(),
+                );
+                view.custom_registry.instances.insert(
+                    2,
+                    super::super::CustomElementEntry {
+                        element_type: kind.into(),
+                        element: Box::new(ReadbackInput(input.clone())),
+                        applied_props: HashMap::new(),
+                    },
+                );
+                view
+            });
+            cx.update_window(handle.into(), |root, window, cx| {
+                root.downcast::<GpuixView>()
+                    .unwrap()
+                    .update(cx, |view, cx| {
+                        view.custom_registry.destroy(4);
+                        let state = input.borrow().state.clone().unwrap();
+                        let read = |view: &GpuixView, cx: &App, expected: &str| {
+                            let before = state.read(cx).public_state();
+                            let history = |state: &TextEditorState| {
+                                [&state.undo_stack, &state.redo_stack].map(|stack| {
+                                    stack
+                                        .iter()
+                                        .map(|entry| {
+                                            (
+                                                entry.content.clone(),
+                                                entry.selected_range.clone(),
+                                                entry.selection_reversed,
+                                            )
+                                        })
+                                        .collect::<Vec<_>>()
+                                })
+                            };
+                            let before_history = history(state.read(cx));
+                            let pending = state.read(cx).pending_values.clone();
+                            let last_edit =
+                                state.read(cx).last_edit.map(|edit| (edit.edit, edit.when));
+                            let blink = state.read(cx).blink_anchor;
+                            let follow = state.read(cx).follow_cursor;
+                            for _ in 0..2 {
+                                let json = view.automation_tree(cx);
+                                assert_eq!(json["children"][0]["text"], expected);
+                                assert_eq!(json["children"][0]["type"], kind);
+                                assert_eq!(json["children"][0]["id"], 2);
+                                assert_eq!(json["children"][0]["testId"], "note-title");
+                                assert_eq!(json["children"][1]["text"], "Label Ω");
+                                assert!(json["children"][2].get("text").is_none());
+                                assert!(json.get("text").is_none());
+                            }
+                            assert_eq!(state.read(cx).public_state(), before);
+                            assert_eq!(history(state.read(cx)), before_history);
+                            assert_eq!(state.read(cx).pending_values, pending);
+                            assert_eq!(
+                                state.read(cx).last_edit.map(|edit| (edit.edit, edit.when)),
+                                last_edit
+                            );
+                            assert_eq!(state.read(cx).blink_anchor, blink);
+                            assert_eq!(state.read(cx).follow_cursor, follow);
+                        };
+                        read(view, cx, original);
+                        state.update(cx, |state, cx| {
+                            state.replace_text_in_range(
+                                Some(0..original.encode_utf16().count()),
+                                edited,
+                                window,
+                                cx,
+                            );
+                            state.selected_range = 0..4;
+                            state.selection_reversed = true;
+                        });
+                        read(view, cx, edited);
+                        state.update(cx, |state, cx| state.undo(&Undo, window, cx));
+                        read(view, cx, original);
+                        state.update(cx, |state, cx| state.redo(&Redo, window, cx));
+                        read(view, cx, edited);
+                        state.update(cx, |state, cx| {
+                            state.replace_and_mark_text_in_range(
+                                Some(0..edited.encode_utf16().count()),
+                                "中😀e\u{301}",
+                                Some(1..3),
+                                window,
+                                cx,
+                            );
+                        });
+                        read(view, cx, "中😀e\u{301}");
+                        assert!(state.read(cx).marked_range.is_some());
+                        state.update(cx, |state, cx| state.unmark_text(window, cx));
+                        read(view, cx, "中😀e\u{301}");
+                        state.update(cx, |state, cx| state.undo(&Undo, window, cx));
+                        read(view, cx, edited);
+                        state.update(cx, |state, cx| {
+                            state.replace_text_in_range(
+                                Some(0..edited.encode_utf16().count()),
+                                "",
+                                window,
+                                cx,
+                            );
+                        });
+                        read(view, cx, "");
+                        view.custom_registry.destroy(2);
+                        assert!(view.automation_tree(cx)["children"][0]
+                            .get("text")
+                            .is_none());
+                        view.tree.lock().unwrap().root_id = None;
+                        view.custom_registry.destroy_all();
+                        cx.notify();
+                        window.refresh();
+                    });
+            })
+            .unwrap();
+            cx.run_until_parked();
+            cx.update_window(handle.into(), |_, window, _| window.remove_window())
+                .unwrap();
+        }
+    }
