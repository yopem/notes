+    fn prepare_owned_close_approval(&self, command: &str) -> Result<CloseApprovalWait> {
+        use crate::window_close::CloseGuardError;
+        self.ensure_close_guard_ready()?;
+        let command = close_commands::request(command)?;
+        let token = {
+            let mut owner = self
+                .close_owner
+                .lock()
+                .map_err(|_| Error::from_reason("Window close state is unavailable"))?;
+            match owner.approve(command.owner, command.request_id) {
+                Ok(token) => token,
+                Err(
+                    CloseGuardError::InvalidOwner
+                    | CloseGuardError::InvalidRequest
+                    | CloseGuardError::Detached
+                    | CloseGuardError::InvalidPhase
+                    | CloseGuardError::Closing,
+                ) => {
+                    let token = crate::window_close::ApprovalToken {
+                        owner: command.owner,
+                        request_id: command.request_id,
+                    };
+                    return Ok(CloseApprovalWait::Ready(close_commands::request_reply(
+                        token,
+                        close_commands::RequestOutcome::Stale,
+                    )));
+                }
+                Err(error) => return Err(close_owner_error(error)),
+            }
+        };
+        #[cfg(target_os = "macos")]
+        {
+            let reply = match update_window_without_view(|window, _cx| {
+                execute_owned_close_approval(&self.close_owner, token, || {
+                    window.remove_window();
+                    Ok(())
+                })
+            }) {
+                Ok(reply) => reply.map_err(Error::from_reason)?,
+                Err(_) => {
+                    revoke_owned_close_approval(&self.close_owner, token);
+                    return Err(Error::from_reason(
+                        "The GPUI window could not begin closing",
+                    ));
+                }
+            };
+            return Ok(CloseApprovalWait::Ready(reply));
+        }
+        #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+        {
+            let (response, receiver) = sync_channel(1);
+            if let Err(error) = self.send_ui_command(UiCommand::CloseOwnedWindow {
+                owner: self.close_owner.clone(),
+                token,
+                response,
+            }) {
+                revoke_owned_close_approval(&self.close_owner, token);
+                return Err(error);
+            }
+            return Ok(CloseApprovalWait::Pending {
+                receiver,
+                owner: self.close_owner.clone(),
+                token,
+            });
+        }
+        #[cfg(not(any(
+            target_os = "macos",
+            target_os = "windows",
+            target_os = "linux",
+            target_os = "freebsd"
+        )))]
+        {
+            revoke_owned_close_approval(&self.close_owner, token);
+            Err(Error::from_reason("Unsupported operating system"))
+        }
+    }
