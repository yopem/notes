@@ -0,0 +1,134 @@
+use napi::{Error, Result};
+use serde::{de::DeserializeOwned, Deserialize, Deserializer, Serialize};
+
+use crate::window_close::{ApprovalToken, BindingSnapshot, MAX_SAFE_ID};
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub(crate) struct BindCommand {
+    #[serde(rename = "protocol", deserialize_with = "protocol_v2")]
+    _protocol: (),
+    #[serde(deserialize_with = "event_id")]
+    pub(crate) event_id: u64,
+    #[serde(deserialize_with = "required_expected_owner")]
+    pub(crate) expected_owner: Option<u64>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub(crate) struct RequestCommand {
+    #[serde(rename = "protocol", deserialize_with = "protocol_v2")]
+    _protocol: (),
+    #[serde(deserialize_with = "positive_id")]
+    pub(crate) owner: u64,
+    #[serde(deserialize_with = "positive_id")]
+    pub(crate) request_id: u64,
+}
+
+impl From<ApprovalToken> for RequestCommand {
+    fn from(token: ApprovalToken) -> Self {
+        Self {
+            _protocol: (),
+            owner: token.owner,
+            request_id: token.request_id,
+        }
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub(crate) struct ReleaseCommand {
+    #[serde(rename = "protocol", deserialize_with = "protocol_v2")]
+    _protocol: (),
+    #[serde(deserialize_with = "positive_id")]
+    pub(crate) owner: u64,
+}
+
+#[derive(Clone, Copy, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) enum RequestOutcome {
+    Cancelled,
+    Closing,
+    Stale,
+}
+
+fn protocol_v2<'de, D: Deserializer<'de>>(reader: D) -> std::result::Result<(), D::Error> {
+    if u8::deserialize(reader)? != 2 {
+        return Err(serde::de::Error::custom("Unsupported close protocol"));
+    }
+    Ok(())
+}
+
+fn event_id<'de, D: Deserializer<'de>>(reader: D) -> std::result::Result<u64, D::Error> {
+    let id = u64::deserialize(reader)?;
+    if id > MAX_SAFE_ID {
+        return Err(serde::de::Error::custom(
+            "Close event ID is not a safe integer",
+        ));
+    }
+    Ok(id)
+}
+
+fn positive_id<'de, D: Deserializer<'de>>(reader: D) -> std::result::Result<u64, D::Error> {
+    let id = event_id(reader)?;
+    if id == 0 {
+        return Err(serde::de::Error::custom("Close identity must be positive"));
+    }
+    Ok(id)
+}
+
+fn required_expected_owner<'de, D: Deserializer<'de>>(
+    reader: D,
+) -> std::result::Result<Option<u64>, D::Error> {
+    let owner = Option::<u64>::deserialize(reader)?;
+    if owner.is_some_and(|owner| owner == 0 || owner > MAX_SAFE_ID) {
+        return Err(serde::de::Error::custom("Invalid expected close owner"));
+    }
+    Ok(owner)
+}
+
+fn decode<T: DeserializeOwned>(command: &str) -> Result<T> {
+    if command.len() > 4096 {
+        return Err(Error::from_reason("Window close command is too large"));
+    }
+    serde_json::from_str(command).map_err(|_| Error::from_reason("Invalid window close command"))
+}
+
+pub(crate) fn bind(command: &str) -> Result<BindCommand> {
+    decode(command)
+}
+
+pub(crate) fn request(command: &str) -> Result<RequestCommand> {
+    decode(command)
+}
+
+pub(crate) fn release(command: &str) -> Result<ReleaseCommand> {
+    decode(command)
+}
+
+pub(crate) fn binding_reply(binding: BindingSnapshot) -> String {
+    serde_json::json!({
+        "protocol": 2,
+        "owner": binding.owner,
+        "eventId": binding.event_id,
+        "pendingRequest": binding.pending_request,
+        "attached": binding.attached,
+        "phase": "armed",
+    })
+    .to_string()
+}
+
+pub(crate) fn request_reply(request: RequestCommand, outcome: RequestOutcome) -> String {
+    serde_json::json!({
+        "protocol": 2,
+        "owner": request.owner,
+        "requestId": request.request_id,
+        "outcome": outcome,
+    })
+    .to_string()
+}
+
+pub(crate) fn release_reply(owner: u64, released: bool) -> String {
+    let outcome = if released { "released" } else { "stale" };
+    serde_json::json!({"protocol": 2, "owner": owner, "outcome": outcome}).to_string()
+}
