+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn arm_close_guard_state(guard: &AtomicU64, event_id: u64) -> Result<()> {
+    match guard.compare_exchange(0, event_id + 1, Ordering::AcqRel, Ordering::Acquire) {
+        Ok(_) => Ok(()),
+        Err(WINDOW_CLOSE_STARTED) => Err(Error::from_reason("Window is closing")),
+        Err(_) => Err(Error::from_reason("Window already has a close guard")),
+    }
