+use serde::{Deserialize, Serialize};
+use std::ops::Range;
+use unicode_segmentation::UnicodeSegmentation;
+
+pub const HISTORY_BYTES: usize = 8 * 1024 * 1024;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum EditorMode {
+    #[default]
+    Insert,
+    Normal,
+    ReadOnly,
+}
+impl EditorMode {
+    pub fn accepts_text(self) -> bool {
+        self == Self::Insert
+    }
+    pub fn routes_keys(self) -> bool {
+        self == Self::Normal
+    }
+}
+
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum Direction {
+    Forward,
+    Backward,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TextSnapshot {
+    pub text: String,
+    pub start: usize,
+    pub end: usize,
+    pub direction: Direction,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct EditorSnapshot {
+    pub version: u32,
+    pub current: TextSnapshot,
+    pub undo: Vec<TextSnapshot>,
+    pub redo: Vec<TextSnapshot>,
+    pub scroll_top: f32,
+    pub scroll_left: f32,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase", deny_unknown_fields)]
+pub enum EditorCommand {
+    #[serde(skip_deserializing)]
+    CheckInputCapture,
+    #[serde(skip_deserializing)]
+    AcquireInputCapture {
+        lease: u64,
+    },
+    #[serde(skip_deserializing)]
+    ReleaseInputCapture {
+        lease: u64,
+    },
+    GetState,
+    GetSnapshot,
+    SetMode {
+        mode: EditorMode,
+    },
+    SetSelection {
+        revision: u64,
+        start: usize,
+        end: usize,
+        direction: Direction,
+    },
+    ReplaceRange {
+        revision: u64,
+        start: usize,
+        end: usize,
+        text: String,
+        selection: Option<TextSelection>,
+    },
+    Undo {
+        revision: u64,
+    },
+    Redo {
+        revision: u64,
+    },
+    SetViewport {
+        top: f32,
+        left: f32,
+    },
+    RestoreSnapshot {
+        revision: u64,
+        snapshot: EditorSnapshot,
+    },
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TextSelection {
+    pub start: usize,
+    pub end: usize,
+    pub direction: Direction,
+}
+
+pub fn checked_offset(text: &str, offset: usize) -> Result<usize, String> {
+    let mut units = 0;
+    for (byte, ch) in text.char_indices() {
+        if units == offset {
+            return Ok(byte);
+        }
+        units += ch.len_utf16();
+        if units > offset {
+            return Err("UTF-16 offset splits a surrogate pair".into());
+        }
+    }
+    if units == offset {
+        Ok(text.len())
+    } else {
+        Err("UTF-16 offset exceeds text length".into())
+    }
+}
+
+pub fn checked_range(text: &str, start: usize, end: usize) -> Result<Range<usize>, String> {
+    if start > end {
+        return Err("Selection start exceeds end".into());
+    }
+    let start = checked_offset(text, start)?;
+    let end = checked_offset(text, end)?;
+    for offset in [start, end] {
+        if offset != text.len()
+            && !text
+                .grapheme_indices(true)
+                .any(|(index, _)| index == offset)
+        {
+            return Err("Range splits an extended grapheme cluster".into());
+        }
+    }
+    Ok(start..end)
+}
+
+pub fn next_grapheme_boundary(text: &str, byte: usize) -> usize {
+    text.grapheme_indices(true)
+        .map(|(index, _)| index)
+        .find(|index| *index >= byte)
+        .unwrap_or(text.len())
+}
+
+pub fn check_revision(actual: u64, expected: u64, composing: bool) -> Result<(), String> {
+    if actual != expected {
+        return Err("Stale editor revision".into());
+    }
+    if composing {
+        return Err("Editor owns an active IME composition".into());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn capture_commands_are_not_publicly_deserializable() {
+        for value in [
+            serde_json::json!({"type": "checkInputCapture"}),
+            serde_json::json!({"type": "acquireInputCapture", "lease": 1}),
+            serde_json::json!({"type": "releaseInputCapture", "lease": 1}),
+        ] {
+            assert!(serde_json::from_value::<EditorCommand>(value).is_err());
+        }
+    }
+
+    #[test]
+    fn utf16_rejects_surrogates_and_out_of_bounds() {
+        let text = "a😀e\u{301}中";
+        assert_eq!(checked_offset(text, 0), Ok(0));
+        assert_eq!(checked_offset(text, 1), Ok(1));
+        assert!(checked_offset(text, 2).is_err());
+        assert_eq!(checked_offset(text, 3), Ok(5));
+        assert!(checked_offset(text, 7).is_err());
+        assert_eq!(checked_offset(text, 6), Ok(text.len()));
+    }
+
+    #[test]
+    fn commands_keep_graphemes_whole() {
+        assert!(checked_range("e\u{301}😀", 0, 1).is_err());
+        assert_eq!(checked_range("e\u{301}😀", 0, 2), Ok(0..3));
+        assert!(checked_range("abc", 2, 1).is_err());
+    }
+
+    #[test]
+    fn caret_stays_after_a_joined_grapheme() {
+        assert_eq!(next_grapheme_boundary("e\u{301}", 1), 3);
+        assert_eq!(
+            next_grapheme_boundary("👩\u{200d}💻", "👩\u{200d}".len()),
+            "👩\u{200d}💻".len()
+        );
+        assert_eq!(next_grapheme_boundary("abc", 1), 1);
+        assert_eq!(next_grapheme_boundary("", 0), 0);
+    }
+
+    #[test]
+    fn command_wire_format_is_strict() {
+        assert!(
+            serde_json::from_str::<EditorCommand>(r#"{"type":"setMode","mode":"normal"}"#).is_ok()
+        );
+        assert!(
+            serde_json::from_str::<EditorCommand>(r#"{"type":"setMode","mode":"wrong"}"#).is_err()
+        );
+        assert!(serde_json::from_str::<EditorCommand>(
+            r#"{"type":"setSelection","revision":1,"start":-1,"end":0,"direction":"forward"}"#
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn revision_and_composition_guards_precede_mutation() {
+        assert!(check_revision(4, 3, false).is_err());
+        assert!(check_revision(4, 4, true).is_err());
+        assert!(check_revision(4, 4, false).is_ok());
+    }
+
+    #[test]
+    fn modal_routing_preserves_insert_and_read_only() {
+        assert!(EditorMode::Insert.accepts_text());
+        assert!(!EditorMode::Normal.accepts_text());
+        assert!(!EditorMode::ReadOnly.accepts_text());
+        assert!(EditorMode::Normal.routes_keys());
+        assert!(!EditorMode::ReadOnly.routes_keys());
+    }
+}
