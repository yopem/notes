+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+const MAX_FONT_BATCH_COUNT: usize = 64;
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+const MAX_FONT_BATCH_BYTES: usize = 32 * 1024 * 1024;
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn validate_font_batch(fonts: &[Vec<u8>]) -> std::result::Result<(), String> {
+    if fonts.is_empty() || fonts.len() > MAX_FONT_BATCH_COUNT {
+        return Err("Invalid font batch count".to_string());
+    }
+    let mut size = 0usize;
+    for font in fonts {
+        size = size
+            .checked_add(font.len())
+            .ok_or("Font batch is too large")?;
+        if font.is_empty() || size > MAX_FONT_BATCH_BYTES {
+            return Err("Invalid font batch size".to_string());
+        }
+    }
+    for font in fonts {
+        check_font(font)?;
+    }
+    Ok(())
+}
+
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+fn send_font_batch(
+    sender: Option<&mpsc::UnboundedSender<UiCommand>>,
+    fonts: Vec<Vec<u8>>,
+    response: SyncSender<std::result::Result<u32, String>>,
+) -> Result<()> {
+    sender
+        .ok_or_else(|| Error::from_reason("GPUI application is not initialized"))?
+        .unbounded_send(UiCommand::RegisterFontBatch { fonts, response })
+        .map_err(|_| Error::from_reason("The GPUI UI thread is not running"))
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn await_font_result(
+    receiver: std::sync::mpsc::Receiver<std::result::Result<u32, String>>,
+) -> Result<u32> {
+    match receiver.recv_timeout(Duration::from_secs(60)) {
+        Ok(result) => result.map_err(Error::from_reason),
+        Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => Err(Error::from_reason(
+            "The GPUI UI thread stopped during font registration",
+        )),
+        Err(std::sync::mpsc::RecvTimeoutError::Timeout) => Err(Error::from_reason(
+            "Font registration timed out; its outcome is unknown and it may still complete",
+        )),
+    }
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+enum CloseApprovalWait {
+    Ready(String),
+    Pending {
+        receiver: std::sync::mpsc::Receiver<std::result::Result<String, String>>,
+        owner: Arc<Mutex<crate::window_close::CloseGuardState>>,
+        token: crate::window_close::ApprovalToken,
+    },
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+pub struct CloseApprovalTask {
+    wait: Option<Result<CloseApprovalWait>>,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[napi]
+impl Task for CloseApprovalTask {
+    type Output = String;
+    type JsValue = String;
+
+    fn compute(&mut self) -> Result<Self::Output> {
+        match self
+            .wait
+            .take()
+            .ok_or_else(|| Error::from_reason("Window close was already awaited"))??
+        {
+            CloseApprovalWait::Ready(reply) => Ok(reply),
+            CloseApprovalWait::Pending {
+                receiver,
+                owner,
+                token,
+            } => await_owned_close_approval(receiver, &owner, token, Duration::from_secs(60)),
+        }
+    }
+
+    fn resolve(&mut self, _env: Env, reply: String) -> Result<Self::JsValue> {
+        Ok(reply)
+    }
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+pub struct FontBatchTask {
+    receiver: Option<Result<std::sync::mpsc::Receiver<std::result::Result<u32, String>>>>,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[napi]
+impl Task for FontBatchTask {
+    type Output = u32;
+    type JsValue = u32;
+
+    fn compute(&mut self) -> Result<Self::Output> {
+        let receiver = self
+            .receiver
+            .take()
+            .ok_or_else(|| Error::from_reason("Font batch was already awaited"))??;
+        await_font_result(receiver)
+    }
+
+    fn resolve(&mut self, _env: Env, count: u32) -> Result<Self::JsValue> {
+        Ok(count)
+    }
+}
