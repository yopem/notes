new file mode 100644
index 0000000000000000000000000000000000000000..015077728918fd081517ebeaf97394409d96f68b
--- /dev/null
+++ b/packages/native/src/window_close.rs
@@ -0,0 +1,573 @@
+pub(crate) const MAX_SAFE_ID: u64 = 9_007_199_254_740_991;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Phase {
+    Armed,
+    Queued,
+    Closing,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct BindingSnapshot {
+    pub(crate) owner: u64,
+    pub(crate) event_id: u64,
+    pub(crate) attached: bool,
+    pub(crate) pending_request: Option<u64>,
+    pub(crate) approval_id: Option<u64>,
+    pub(crate) phase: Phase,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Delivery {
+    pub(crate) owner: u64,
+    pub(crate) event_id: u64,
+    pub(crate) request_id: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct ApprovalToken {
+    pub(crate) owner: u64,
+    pub(crate) request_id: u64,
+    pub(crate) approval_id: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CloseRequest {
+    Allow,
+    Veto(Option<Delivery>),
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CloseGuardError {
+    InvalidOwner,
+    InvalidRequest,
+    InvalidApproval,
+    Detached,
+    InvalidPhase,
+    Closing,
+    IdExhausted,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct CloseGuardState {
+    binding: Option<BindingSnapshot>,
+    last_owner: u64,
+    last_request: u64,
+    last_approval: u64,
+}
+
+impl CloseGuardState {
+    pub(crate) fn snapshot(&self) -> Option<BindingSnapshot> {
+        self.binding
+    }
+
+    pub(crate) fn bind(
+        &mut self,
+        expected_owner: Option<u64>,
+        event_id: u64,
+    ) -> Result<BindingSnapshot, CloseGuardError> {
+        if self.binding.map(|binding| binding.owner) != expected_owner {
+            return Err(CloseGuardError::InvalidOwner);
+        }
+        if self
+            .binding
+            .is_some_and(|binding| binding.phase == Phase::Closing)
+        {
+            return Err(CloseGuardError::Closing);
+        }
+        let owner = self
+            .last_owner
+            .checked_add(1)
+            .filter(|id| *id <= MAX_SAFE_ID)
+            .ok_or(CloseGuardError::IdExhausted)?;
+        let binding = BindingSnapshot {
+            owner,
+            event_id,
+            attached: true,
+            pending_request: self.binding.and_then(|binding| binding.pending_request),
+            approval_id: None,
+            phase: Phase::Armed,
+        };
+        self.last_owner = owner;
+        self.binding = Some(binding);
+        Ok(binding)
+    }
+
+    pub(crate) fn release(&mut self, owner: u64) -> Result<(), CloseGuardError> {
+        let binding = self.current_owner_mut(owner)?;
+        binding.attached = false;
+        if binding.phase == Phase::Queued {
+            binding.phase = Phase::Armed;
+            binding.approval_id = None;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn request_close(&mut self) -> Result<CloseRequest, CloseGuardError> {
+        let Some(binding) = self.binding.as_mut() else {
+            return Ok(CloseRequest::Allow);
+        };
+        let request_id = match binding.pending_request {
+            Some(id) => id,
+            None => {
+                let id = self
+                    .last_request
+                    .checked_add(1)
+                    .filter(|id| *id <= MAX_SAFE_ID)
+                    .ok_or(CloseGuardError::IdExhausted)?;
+                self.last_request = id;
+                binding.pending_request = Some(id);
+                id
+            }
+        };
+        let delivery = (binding.attached && binding.phase != Phase::Closing).then_some(Delivery {
+            owner: binding.owner,
+            event_id: binding.event_id,
+            request_id,
+        });
+        Ok(CloseRequest::Veto(delivery))
+    }
+
+    pub(crate) fn approve(
+        &mut self,
+        owner: u64,
+        request_id: u64,
+    ) -> Result<ApprovalToken, CloseGuardError> {
+        let next_approval = self
+            .last_approval
+            .checked_add(1)
+            .filter(|id| *id <= MAX_SAFE_ID);
+        let binding = self.current_request_mut(owner, request_id)?;
+        if binding.phase == Phase::Closing {
+            return Err(CloseGuardError::Closing);
+        }
+        if !binding.attached {
+            return Err(CloseGuardError::Detached);
+        }
+        if binding.phase != Phase::Armed {
+            return Err(CloseGuardError::InvalidPhase);
+        }
+        let approval_id = next_approval.ok_or(CloseGuardError::IdExhausted)?;
+        binding.phase = Phase::Queued;
+        binding.approval_id = Some(approval_id);
+        self.last_approval = approval_id;
+        Ok(ApprovalToken {
+            owner,
+            request_id,
+            approval_id,
+        })
+    }
+
+    pub(crate) fn revoke_approval(&mut self, token: ApprovalToken) -> Result<(), CloseGuardError> {
+        let binding = self.current_approval_mut(token)?;
+        if binding.phase != Phase::Queued {
+            return Err(CloseGuardError::InvalidPhase);
+        }
+        binding.phase = Phase::Armed;
+        binding.approval_id = None;
+        Ok(())
+    }
+
+    pub(crate) fn execute_approval(&mut self, token: ApprovalToken) -> Result<(), CloseGuardError> {
+        let binding = self.current_approval_mut(token)?;
+        if binding.phase != Phase::Queued {
+            return Err(CloseGuardError::InvalidPhase);
+        }
+        if !binding.attached {
+            return Err(CloseGuardError::Detached);
+        }
+        binding.phase = Phase::Closing;
+        Ok(())
+    }
+
+    pub(crate) fn close_failed(&mut self, token: ApprovalToken) -> Result<(), CloseGuardError> {
+        let binding = self.current_approval_mut(token)?;
+        if binding.phase != Phase::Closing {
+            return Err(CloseGuardError::InvalidPhase);
+        }
+        binding.phase = Phase::Armed;
+        binding.approval_id = None;
+        Ok(())
+    }
+
+    pub(crate) fn cancel_approval(&mut self, token: ApprovalToken) -> Result<(), CloseGuardError> {
+        let binding = self.current_approval_mut(token)?;
+        if binding.phase != Phase::Queued {
+            return Err(CloseGuardError::InvalidPhase);
+        }
+        self.cancel(token.owner, token.request_id)
+    }
+
+    pub(crate) fn cancel(&mut self, owner: u64, request_id: u64) -> Result<(), CloseGuardError> {
+        let binding = self.current_request_mut(owner, request_id)?;
+        if binding.phase == Phase::Closing {
+            return Err(CloseGuardError::Closing);
+        }
+        binding.pending_request = None;
+        binding.approval_id = None;
+        binding.phase = Phase::Armed;
+        Ok(())
+    }
+
+    fn current_approval_mut(
+        &mut self,
+        token: ApprovalToken,
+    ) -> Result<&mut BindingSnapshot, CloseGuardError> {
+        let binding = self.current_request_mut(token.owner, token.request_id)?;
+        if binding.approval_id != Some(token.approval_id) {
+            return Err(CloseGuardError::InvalidApproval);
+        }
+        Ok(binding)
+    }
+
+    fn current_owner_mut(&mut self, owner: u64) -> Result<&mut BindingSnapshot, CloseGuardError> {
+        self.binding
+            .as_mut()
+            .filter(|binding| binding.owner == owner)
+            .ok_or(CloseGuardError::InvalidOwner)
+    }
+
+    fn current_request_mut(
+        &mut self,
+        owner: u64,
+        request_id: u64,
+    ) -> Result<&mut BindingSnapshot, CloseGuardError> {
+        let binding = self.current_owner_mut(owner)?;
+        if binding.pending_request != Some(request_id) {
+            return Err(CloseGuardError::InvalidRequest);
+        }
+        Ok(binding)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn approval_generations_fence_old_retry_operations() {
+        let (mut state, binding) = bound();
+        let delivery = request(&mut state);
+        let first = state.approve(binding.owner, delivery.request_id).unwrap();
+        state.revoke_approval(first).unwrap();
+        let second = state.approve(binding.owner, delivery.request_id).unwrap();
+        assert!(second.approval_id > first.approval_id);
+        let expected = state.clone();
+        assert_eq!(
+            state.cancel_approval(first),
+            Err(CloseGuardError::InvalidApproval)
+        );
+        assert_eq!(
+            state.revoke_approval(first),
+            Err(CloseGuardError::InvalidApproval)
+        );
+        assert_eq!(
+            state.execute_approval(first),
+            Err(CloseGuardError::InvalidApproval)
+        );
+        assert_eq!(
+            state.close_failed(first),
+            Err(CloseGuardError::InvalidApproval)
+        );
+        assert_eq!(state, expected);
+        state.execute_approval(second).unwrap();
+        assert_eq!(state.snapshot().unwrap().phase, Phase::Closing);
+    }
+
+    #[test]
+    fn approval_generations_do_not_repeat_after_retarget() {
+        let (mut state, binding) = bound();
+        let delivery = request(&mut state);
+        let first = state.approve(binding.owner, delivery.request_id).unwrap();
+        let next = state.bind(Some(binding.owner), 11).unwrap();
+        let second = state.approve(next.owner, delivery.request_id).unwrap();
+        assert!(second.approval_id > first.approval_id);
+        assert_eq!(second.request_id, first.request_id);
+    }
+
+    #[test]
+    fn approval_generation_exhaustion_does_not_change_state() {
+        let (mut state, binding) = bound();
+        let delivery = request(&mut state);
+        state.last_approval = MAX_SAFE_ID;
+        let expected = state.clone();
+        assert_eq!(
+            state.approve(binding.owner, delivery.request_id),
+            Err(CloseGuardError::IdExhausted)
+        );
+        assert_eq!(state, expected);
+        assert_eq!(request(&mut state), delivery);
+    }
+
+    fn bound() -> (CloseGuardState, BindingSnapshot) {
+        let mut state = CloseGuardState::default();
+        let binding = state.bind(None, 10).unwrap();
+        (state, binding)
+    }
+
+    fn request(state: &mut CloseGuardState) -> Delivery {
+        match state.request_close().unwrap() {
+            CloseRequest::Veto(Some(delivery)) => delivery,
+            other => panic!("expected delivery, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn unarmed_allows_close() {
+        let mut state = CloseGuardState::default();
+        assert_eq!(state.snapshot(), None);
+        assert_eq!(state.request_close(), Ok(CloseRequest::Allow));
+    }
+
+    #[test]
+    fn detached_binding_still_vetoes_and_replays_pending() {
+        let (mut state, binding) = bound();
+        state.release(binding.owner).unwrap();
+        assert_eq!(state.request_close(), Ok(CloseRequest::Veto(None)));
+        let pending = state.snapshot().unwrap().pending_request.unwrap();
+        assert_eq!(state.request_close(), Ok(CloseRequest::Veto(None)));
+        let next = state.bind(Some(binding.owner), 10).unwrap();
+        assert_eq!(next.pending_request, Some(pending));
+        assert_eq!(
+            request(&mut state),
+            Delivery {
+                owner: next.owner,
+                event_id: 10,
+                request_id: pending
+            }
+        );
+    }
+
+    #[test]
+    fn missing_or_wrong_expected_owner_is_atomic() {
+        let (mut state, binding) = bound();
+        let before = state.clone();
+        assert_eq!(state.bind(None, 11), Err(CloseGuardError::InvalidOwner));
+        assert_eq!(state, before);
+        assert_eq!(
+            state.bind(Some(binding.owner + 1), 11),
+            Err(CloseGuardError::InvalidOwner)
+        );
+        assert_eq!(state, before);
+        let mut empty = CloseGuardState::default();
+        let before = empty.clone();
+        assert_eq!(empty.bind(Some(1), 11), Err(CloseGuardError::InvalidOwner));
+        assert_eq!(empty, before);
+    }
+
+    #[test]
+    fn retarget_preserves_pending_for_same_and_new_event() {
+        let (mut state, first) = bound();
+        let pending = request(&mut state).request_id;
+        let second = state.bind(Some(first.owner), 10).unwrap();
+        assert_eq!(second.pending_request, Some(pending));
+        assert_eq!(
+            request(&mut state),
+            Delivery {
+                owner: second.owner,
+                event_id: 10,
+                request_id: pending
+            }
+        );
+        let third = state.bind(Some(second.owner), 20).unwrap();
+        assert_eq!(third.pending_request, Some(pending));
+        assert_eq!(
+            request(&mut state),
+            Delivery {
+                owner: third.owner,
+                event_id: 20,
+                request_id: pending
+            }
+        );
+    }
+
+    #[test]
+    fn stale_owner_cannot_approve_release_or_cancel() {
+        let (mut state, first) = bound();
+        let pending = request(&mut state).request_id;
+        let second = state.bind(Some(first.owner), 20).unwrap();
+        let before = state.clone();
+        assert_eq!(
+            state.approve(first.owner, pending),
+            Err(CloseGuardError::InvalidOwner)
+        );
+        assert_eq!(
+            state.release(first.owner),
+            Err(CloseGuardError::InvalidOwner)
+        );
+        assert_eq!(
+            state.cancel(first.owner, pending),
+            Err(CloseGuardError::InvalidOwner)
+        );
+        assert_eq!(state, before);
+        assert_eq!(request(&mut state).owner, second.owner);
+    }
+
+    #[test]
+    fn retarget_revokes_queued_approval() {
+        let (mut state, first) = bound();
+        let pending = request(&mut state).request_id;
+        let token = state.approve(first.owner, pending).unwrap();
+        let second = state.bind(Some(first.owner), 11).unwrap();
+        assert_eq!(second.phase, Phase::Armed);
+        let before = state.clone();
+        assert!(state.execute_approval(token).is_err());
+        assert_eq!(state, before);
+        assert_eq!(request(&mut state).request_id, pending);
+    }
+
+    #[test]
+    fn cancel_and_release_revoke_queued_approval() {
+        let (mut state, first) = bound();
+        let pending = request(&mut state).request_id;
+        let token = state.approve(first.owner, pending).unwrap();
+        state.cancel(first.owner, pending).unwrap();
+        let before = state.clone();
+        assert!(state.execute_approval(token).is_err());
+        assert_eq!(state, before);
+        let pending2 = request(&mut state).request_id;
+        assert_ne!(pending, pending2);
+        let token2 = state.approve(first.owner, pending2).unwrap();
+        state.release(first.owner).unwrap();
+        let before = state.clone();
+        assert!(state.execute_approval(token2).is_err());
+        assert_eq!(state, before);
+        assert_eq!(state.request_close(), Ok(CloseRequest::Veto(None)));
+        assert_eq!(state.snapshot().unwrap().pending_request, Some(pending2));
+    }
+
+    #[test]
+    fn executing_rejects_retarget_and_cancel_and_release_keeps_closing() {
+        let (mut state, binding) = bound();
+        let pending = request(&mut state).request_id;
+        let token = state.approve(binding.owner, pending).unwrap();
+        state.execute_approval(token).unwrap();
+        let before = state.clone();
+        assert_eq!(
+            state.bind(Some(binding.owner), 11),
+            Err(CloseGuardError::Closing)
+        );
+        assert_eq!(
+            state.cancel(binding.owner, pending),
+            Err(CloseGuardError::Closing)
+        );
+        assert!(state.execute_approval(token).is_err());
+        assert_eq!(state, before);
+        assert_eq!(state.request_close(), Ok(CloseRequest::Veto(None)));
+        state.release(binding.owner).unwrap();
+        let snapshot = state.snapshot().unwrap();
+        assert!(!snapshot.attached);
+        assert_eq!(snapshot.phase, Phase::Closing);
+    }
+
+    #[test]
+    fn failed_removal_restores_veto_and_preserves_attachment() {
+        let (mut state, binding) = bound();
+        let pending = request(&mut state).request_id;
+        let token = state.approve(binding.owner, pending).unwrap();
+        state.execute_approval(token).unwrap();
+        state.close_failed(token).unwrap();
+        assert_eq!(state.snapshot().unwrap().phase, Phase::Armed);
+        assert_eq!(request(&mut state).request_id, pending);
+        let token = state.approve(binding.owner, pending).unwrap();
+        state.execute_approval(token).unwrap();
+        state.release(binding.owner).unwrap();
+        state.close_failed(token).unwrap();
+        assert_eq!(state.request_close(), Ok(CloseRequest::Veto(None)));
+        assert_eq!(state.snapshot().unwrap().pending_request, Some(pending));
+    }
+
+    #[test]
+    fn wrong_failure_token_and_wrong_phase_do_not_mutate() {
+        let (mut state, binding) = bound();
+        let pending = request(&mut state).request_id;
+        let token = state.approve(binding.owner, pending).unwrap();
+        let before = state.clone();
+        assert!(state.close_failed(token).is_err());
+        assert_eq!(state, before);
+        state.execute_approval(token).unwrap();
+        let before = state.clone();
+        assert!(state
+            .close_failed(ApprovalToken {
+                owner: token.owner + 1,
+                ..token
+            })
+            .is_err());
+        assert!(state
+            .close_failed(ApprovalToken {
+                request_id: token.request_id + 1,
+                ..token
+            })
+            .is_err());
+        assert_eq!(state, before);
+    }
+
+    #[test]
+    fn owners_and_requests_never_reuse_ids() {
+        let (mut state, first) = bound();
+        let first_request = request(&mut state).request_id;
+        state.cancel(first.owner, first_request).unwrap();
+        let second_request = request(&mut state).request_id;
+        let second = state.bind(Some(first.owner), first.event_id).unwrap();
+        let third = state.bind(Some(second.owner), first.event_id).unwrap();
+        assert!(first.owner < second.owner && second.owner < third.owner);
+        assert!(first_request < second_request);
+        let before = state.clone();
+        assert!(state.cancel(first.owner, first_request).is_err());
+        assert_eq!(state, before);
+    }
+
+    #[test]
+    fn repeated_requests_deduplicate_and_queue_failure_preserves_pending() {
+        let (mut state, binding) = bound();
+        let first = request(&mut state);
+        assert_eq!(request(&mut state), first);
+        let token = state.approve(binding.owner, first.request_id).unwrap();
+        state.revoke_approval(token).unwrap();
+        assert_eq!(state.snapshot().unwrap().phase, Phase::Armed);
+        assert_eq!(request(&mut state), first);
+        let before = state.clone();
+        assert!(state.revoke_approval(token).is_err());
+        assert_eq!(state, before);
+    }
+
+    #[test]
+    fn exhaustion_fails_closed_without_partial_changes() {
+        let (mut state, binding) = bound();
+        state.last_owner = MAX_SAFE_ID;
+        let before = state.clone();
+        assert_eq!(
+            state.bind(Some(binding.owner), 11),
+            Err(CloseGuardError::IdExhausted)
+        );
+        assert_eq!(state, before);
+        state.last_request = MAX_SAFE_ID;
+        let before = state.clone();
+        assert_eq!(state.request_close(), Err(CloseGuardError::IdExhausted));
+        assert_eq!(state, before);
+        assert!(state.snapshot().is_some());
+    }
+
+    #[test]
+    fn invalid_request_and_detached_approval_are_atomic() {
+        let (mut state, binding) = bound();
+        let pending = request(&mut state).request_id;
+        let before = state.clone();
+        assert_eq!(
+            state.approve(binding.owner, pending + 1),
+            Err(CloseGuardError::InvalidRequest)
+        );
+        assert_eq!(
+            state.cancel(binding.owner, pending + 1),
+            Err(CloseGuardError::InvalidRequest)
+        );
+        assert_eq!(state, before);
+        state.release(binding.owner).unwrap();
+        let before = state.clone();
+        assert_eq!(
+            state.approve(binding.owner, pending),
+            Err(CloseGuardError::Detached)
+        );
+        assert_eq!(state, before);
+    }
+}
