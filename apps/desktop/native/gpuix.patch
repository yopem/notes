+#[derive(Clone, Debug, PartialEq, Eq)]
+struct EditorIdentity {
+    owner: u64,
+    context: String,
+}
+
+fn editor_identity(
+    owner: &serde_json::Value,
+    context: &serde_json::Value,
+    identity_seen: bool,
+) -> Result<Option<EditorIdentity>, String> {
+    if !identity_seen {
+        return Ok(None);
+    }
+    let owner = owner
+        .as_f64()
+        .filter(|value| {
+            value.is_finite()
+                && *value >= 1.0
+                && *value <= 9_007_199_254_740_991.0
+                && value.fract() == 0.0
+        })
+        .ok_or("Invalid editor owner: expected a positive safe integer")?;
+    let context = context.as_str().filter(|value| !value.is_empty() && value.len() <= 1024 && value.trim() == *value && !value.chars().any(char::is_control))
+        .ok_or("Invalid editor context: expected nonempty text up to 1024 bytes without control or edge whitespace")?;
+    Ok(Some(EditorIdentity {
+        owner: owner as u64,
+        context: context.to_owned(),
+    }))
+}
