+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn owned_close_should_close(
+    guard: &AtomicU64,
+    owner: &Mutex<crate::window_close::CloseGuardState>,
+    callback: &Option<EventCallback>,
+) -> bool {
+    enum Notice {
+        Allow,
+        Legacy(u64),
+        Owned(crate::window_close::Delivery),
+        Veto,
+    }
+    let notice = {
+        let Ok(mut owner) = owner.lock() else {
+            return false;
+        };
+        if owner.snapshot().is_none() {
+            if close_guard_should_close(guard, &None) {
+                Notice::Allow
+            } else {
+                Notice::Legacy(guard.load(Ordering::Acquire) - 1)
+            }
+        } else {
+            match owner.request_close() {
+                Ok(crate::window_close::CloseRequest::Veto(Some(delivery))) => {
+                    Notice::Owned(delivery)
+                }
+                _ => Notice::Veto,
+            }
+        }
+    };
+    match notice {
+        Notice::Allow => true,
+        Notice::Legacy(id) => {
+            emit_event_full(callback, id, "windowCloseRequested", |_| {});
+            false
+        }
+        Notice::Owned(delivery) => {
+            emit_event_full(
+                callback,
+                delivery.event_id,
+                "windowCloseRequested",
+                |event| {
+                    event.value = Some(
+                        serde_json::json!({
+                            "protocol": 2,
+                            "owner": delivery.owner,
+                            "requestId": delivery.request_id,
+                        })
+                        .to_string(),
+                    );
+                },
+            );
+            false
+        }
+        Notice::Veto => false,
+    }
+}
