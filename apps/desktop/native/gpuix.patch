+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn close_owner_error(error: crate::window_close::CloseGuardError) -> Error {
+    use crate::window_close::CloseGuardError;
+    Error::from_reason(match error {
+        CloseGuardError::InvalidOwner => "Window close ownership changed",
+        CloseGuardError::InvalidRequest => "Window close request is no longer current",
+        CloseGuardError::Detached => "Window close owner is detached",
+        CloseGuardError::InvalidPhase => "Window close approval is already queued",
+        CloseGuardError::Closing => "Window is already closing",
+        CloseGuardError::IdExhausted => {
+            "Window close identities are exhausted; restart is required"
+        }
+    })
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn bind_owned_close_state(
+    legacy: &AtomicU64,
+    owner: &Mutex<crate::window_close::CloseGuardState>,
+    command: close_commands::BindCommand,
+) -> Result<String> {
+    let mut owner = owner
+        .lock()
+        .map_err(|_| Error::from_reason("Window close state is unavailable"))?;
+    if legacy.load(Ordering::Acquire) != 0 {
+        return Err(Error::from_reason(
+            "Legacy close ownership cannot be replaced; restart is required",
+        ));
+    }
+    let binding = owner
+        .bind(command.expected_owner, command.event_id)
+        .map_err(close_owner_error)?;
+    Ok(close_commands::binding_reply(binding))
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn execute_owned_close_approval(
+    owner: &Mutex<crate::window_close::CloseGuardState>,
+    token: crate::window_close::ApprovalToken,
+    remove: impl FnOnce() -> std::result::Result<(), String>,
+) -> std::result::Result<String, String> {
+    let mut owner = owner
+        .lock()
+        .map_err(|_| "Window close state is unavailable".to_string())?;
+    if owner.execute_approval(token).is_err() {
+        return Ok(close_commands::request_reply(
+            token,
+            close_commands::RequestOutcome::Stale,
+        ));
+    }
+    if let Err(error) = remove() {
+        owner
+            .close_failed(token)
+            .map_err(|_| "Window close recovery failed; restart is required".to_string())?;
+        return Err(error);
+    }
+    Ok(close_commands::request_reply(
+        token,
+        close_commands::RequestOutcome::Closing,
+    ))
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn revoke_owned_close_approval(
+    owner: &Mutex<crate::window_close::CloseGuardState>,
+    token: crate::window_close::ApprovalToken,
+) {
+    if let Ok(mut owner) = owner.lock() {
+        let _ = owner.revoke_approval(token);
+    }
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn await_owned_close_approval(
+    receiver: std::sync::mpsc::Receiver<std::result::Result<String, String>>,
+    owner: &Mutex<crate::window_close::CloseGuardState>,
+    token: crate::window_close::ApprovalToken,
+    timeout: Duration,
+) -> Result<String> {
+    match receiver.recv_timeout(timeout) {
+        Ok(reply) => reply.map_err(Error::from_reason),
+        Err(error) => {
+            if let Ok(mut owner) = owner.lock() {
+                if owner
+                    .snapshot()
+                    .is_some_and(|binding| binding.phase == crate::window_close::Phase::Queued)
+                {
+                    let _ = owner.cancel(token.owner, token.request_id);
+                }
+            }
+            Err(Error::from_reason(match error {
+                std::sync::mpsc::RecvTimeoutError::Disconnected => {
+                    "The window close reply was lost; keep the window open or request close again"
+                }
+                std::sync::mpsc::RecvTimeoutError::Timeout => {
+                    "Window close timed out and may already be closing; do not assume it closed"
+                }
+            }))
+        }
+    }
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn arm_legacy_close_guard(
+    guard: &AtomicU64,
+    owner: &Mutex<crate::window_close::CloseGuardState>,
+    event_id: u64,
+) -> Result<()> {
+    let owner = owner
+        .lock()
+        .map_err(|_| Error::from_reason("Window close state is unavailable"))?;
+    if owner.snapshot().is_some() {
+        return Err(Error::from_reason("Window has a versioned close owner"));
+    }
+    arm_close_guard_state(guard, event_id)
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn install_close_guard(
+    window: &gpui::Window,
+    cx: &gpui::App,
+    guard: Arc<AtomicU64>,
+    owner: Arc<Mutex<crate::window_close::CloseGuardState>>,
+    callback: Option<EventCallback>,
+) -> CloseRequestHandler {
+    let request: CloseRequestHandler =
+        std::rc::Rc::new(move || owned_close_should_close(&guard, &owner, &callback));
+    let native_request = request.clone();
+    let fallback_request = request.clone();
+    window.on_window_should_close_or(
+        cx,
+        move |_window, _cx| native_request(),
+        move || fallback_request(),
+    );
+    request
+}
