+    fn public_snapshot(snapshot: &EditSnapshot) -> TextSnapshot {
+        TextSnapshot {
+            text: snapshot.content.clone(),
+            start: snapshot.content[..snapshot.selected_range.start]
+                .encode_utf16()
+                .count(),
+            end: snapshot.content[..snapshot.selected_range.end]
+                .encode_utf16()
+                .count(),
+            direction: if snapshot.selection_reversed {
+                Direction::Backward
+            } else {
+                Direction::Forward
+            },
+        }
+    }
+
+    fn import_snapshot(snapshot: TextSnapshot, multiline: bool) -> Result<EditSnapshot, String> {
+        if !multiline && single_line_text(&snapshot.text) != snapshot.text {
+            return Err("Single-line snapshot contains line breaks".into());
+        }
+        // Native IME can select scalar boundaries inside a grapheme cluster.
+        let start = checked_offset(&snapshot.text, snapshot.start)?;
+        let end = checked_offset(&snapshot.text, snapshot.end)?;
+        if start > end {
+            return Err("Snapshot selection is reversed".into());
+        }
+        Ok(EditSnapshot {
+            content: snapshot.text,
+            selected_range: start..end,
+            selection_reversed: matches!(snapshot.direction, Direction::Backward),
+        })
+    }
+
+    fn public_state(&self) -> serde_json::Value {
+        let range = self.range_to_utf16(&self.selected_range);
+        let bounds = self.last_bounds.map(|bounds| bounds.size);
+        serde_json::json!({
+            "text": self.content, "revision": self.revision,
+            "selection": { "start": range.start, "end": range.end,
+                "direction": if self.selection_reversed { "backward" } else { "forward" } },
+            "composition": self.marked_range.as_ref().map(|range| {
+                let range = self.range_to_utf16(range);
+                serde_json::json!({"start": range.start, "end": range.end})
+            }),
+            "mode": self.mode,
+            "readOnly": self.read_only || self.mode == EditorMode::ReadOnly,
+            "canUndo": !self.undo_stack.is_empty(), "canRedo": !self.redo_stack.is_empty(),
+            "viewport": { "top": self.scroll_top, "left": self.scroll_left,
+                "width": bounds.map(|size| f32::from(size.width)).unwrap_or(0.0),
+                "height": bounds.map(|size| f32::from(size.height)).unwrap_or(0.0),
+                "contentHeight": self.content_height, "contentWidth": self.content_width }
+        })
+    }
