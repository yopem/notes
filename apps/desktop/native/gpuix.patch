+
+    #[test]
+    fn waits_for_delayed_font_reply() {
+        let (sender, receiver) = sync_channel(1);
+        let start = Instant::now();
+        let worker = std::thread::spawn(move || await_font_result(receiver));
+        std::thread::sleep(Duration::from_millis(2100));
+        assert!(!worker.is_finished());
+        sender.send(Ok(2)).unwrap();
+        assert_eq!(worker.join().unwrap().unwrap(), 2);
+        assert!(start.elapsed() >= Duration::from_secs(2));
+    }
+
+    #[test]
+    fn reports_font_failure_and_disconnect() {
+        let (sender, receiver) = sync_channel(1);
+        sender.send(Err("backend failed".to_string())).unwrap();
+        assert!(await_font_result(receiver)
+            .unwrap_err()
+            .to_string()
+            .contains("backend failed"));
+        let (sender, receiver) = sync_channel(1);
+        drop(sender);
+        assert!(await_font_result(receiver)
+            .unwrap_err()
+            .to_string()
+            .contains("stopped"));
+    }
+
+    #[test]
+    fn rejects_font_batch_bounds_and_invalid_fonts() {
