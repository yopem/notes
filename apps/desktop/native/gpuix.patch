+        assert!(validate_font_batch(&[vec![]]).is_err());
+        assert!(validate_font_batch(&vec![vec![1]; MAX_FONT_BATCH_COUNT + 1]).is_err());
+        assert!(validate_font_batch(&[vec![1; MAX_FONT_BATCH_BYTES + 1]]).is_err());
+        assert!(validate_font_batch(&[vec![1, 2, 3, 4]]).is_err());
+    }
+
+    #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+    #[test]
+    fn rejects_closed_font_command_queue() {
+        let (sender, receiver) = mpsc::unbounded();
+        drop(receiver);
+        let (response, reply) = sync_channel(1);
+        assert!(send_font_batch(Some(&sender), vec![vec![1]], response).is_err());
+        assert!(await_font_result(reply).is_err());
+        let (response, reply) = sync_channel(1);
+        assert!(send_font_batch(None, vec![vec![1]], response).is_err());
+        assert!(await_font_result(reply).is_err());
+    }
