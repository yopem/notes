+fn underline_marked_runs(runs: Vec<TextRun>, marked: &Range<usize>) -> Vec<TextRun> {
+    let mut result = Vec::new();
+    let mut at = 0;
+    for run in runs {
+        let end = at + run.len;
+        let mut boundaries = vec![at, end];
+        for boundary in [marked.start, marked.end] {
+            if boundary > at && boundary < end {
+                boundaries.push(boundary);
+            }
+        }
+        boundaries.sort_unstable();
+        for pair in boundaries.windows(2) {
+            let mut part = run.clone();
+            part.len = pair[1] - pair[0];
+            if pair[0] >= marked.start && pair[1] <= marked.end {
+                part.underline = Some(UnderlineStyle {
+                    color: Some(part.color),
+                    thickness: px(1.0),
+                    wavy: false,
+                });
+            }
+            result.push(part);
+        }
+        at = end;
+    }
+    result
+}
