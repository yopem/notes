+const WINDOW_CLOSE_STARTED: u64 = u64::MAX;
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn close_guard_should_close(guard: &AtomicU64, callback: &Option<EventCallback>) -> bool {
+    let event_id = match guard.compare_exchange(
+        0,
+        WINDOW_CLOSE_STARTED,
+        Ordering::AcqRel,
+        Ordering::Acquire,
+    ) {
+        Ok(_) => return true,
+        Err(event_id) => event_id,
+    };
+    if event_id == WINDOW_CLOSE_STARTED {
+        return true;
+    }
+    emit_event_full(callback, event_id - 1, "windowCloseRequested", |_| {});
+    false
+}
