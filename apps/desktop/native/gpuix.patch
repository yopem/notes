+#[cfg(all(test, not(all(target_arch = "wasm32", target_os = "unknown"))))]
+mod async_font_tests {
+    use super::*;
+    use std::sync::mpsc::sync_channel;
+    use std::time::{Duration, Instant};
+
+    #[test]
+    fn waits_for_delayed_font_reply() {
+        let (sender, receiver) = sync_channel(1);
+        let start = Instant::now();
+        let worker = std::thread::spawn(move || await_font_result(receiver));
+        std::thread::sleep(Duration::from_millis(2100));
+        assert!(!worker.is_finished());
+        sender.send(Ok(2)).unwrap();
+        assert_eq!(worker.join().unwrap().unwrap(), 2);
+        assert!(start.elapsed() >= Duration::from_secs(2));
+    }
+
+    #[test]
+    fn reports_font_failure_and_disconnect() {
+        let (sender, receiver) = sync_channel(1);
+        sender.send(Err("backend failed".to_string())).unwrap();
+        assert!(await_font_result(receiver)
+            .unwrap_err()
+            .to_string()
+            .contains("backend failed"));
+        let (sender, receiver) = sync_channel(1);
+        drop(sender);
+        assert!(await_font_result(receiver)
+            .unwrap_err()
+            .to_string()
+            .contains("stopped"));
+    }
+
+    #[test]
+    fn rejects_font_batch_bounds_and_invalid_fonts() {
+        assert!(validate_font_batch(&[]).is_err());
+        assert!(validate_font_batch(&[vec![]]).is_err());
+        assert!(validate_font_batch(&vec![vec![1]; MAX_FONT_BATCH_COUNT + 1]).is_err());
+        assert!(validate_font_batch(&[vec![1; MAX_FONT_BATCH_BYTES + 1]]).is_err());
+        assert!(validate_font_batch(&[vec![1, 2, 3, 4]]).is_err());
+    }
+
+    #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+    #[test]
+    fn rejects_closed_font_command_queue() {
+        let (sender, receiver) = mpsc::unbounded();
+        drop(receiver);
+        let (response, reply) = sync_channel(1);
+        assert!(send_font_batch(Some(&sender), vec![vec![1]], response).is_err());
+        assert!(await_font_result(reply).is_err());
+        let (response, reply) = sync_channel(1);
+        assert!(send_font_batch(None, vec![vec![1]], response).is_err());
+        assert!(await_font_result(reply).is_err());
+    }
+}
