+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn install_close_guard(
+    window: &gpui::Window,
+    cx: &gpui::App,
+    guard: Arc<AtomicU64>,
+    owner: Arc<Mutex<crate::window_close::CloseGuardState>>,
+    callback: Option<EventCallback>,
+) -> CloseRequestHandler {
+    let request: CloseRequestHandler =
+        std::rc::Rc::new(move || owned_close_should_close(&guard, &owner, &callback));
+    let native_request = request.clone();
+    let fallback_request = request.clone();
+    window.on_window_should_close_or(
+        cx,
+        move |_window, _cx| native_request(),
+        move || fallback_request(),
+    );
+    request
+}
