+    #[gpui::test]
+    fn test_close_fallback_is_scoped_and_tracks_guard(cx: &mut TestAppContext) {
+        cx.update(|cx| cx.set_quit_mode(crate::QuitMode::Explicit));
+        let guarded = Rc::new(Cell::new(false));
+        let calls = Rc::new(Cell::new(0));
+        let window = cx.add_window(|_, _| EmptyView);
+        cx.update_window(window.into(), |_, window, cx| {
+            let callback_guard = guarded.clone();
+            let callback_calls = calls.clone();
+            let fallback_guard = guarded.clone();
+            window.on_window_should_close_or(
+                cx,
+                move |_, _| {
+                    callback_calls.set(callback_calls.get() + 1);
+                    !callback_guard.get()
+                },
+                move || !fallback_guard.get(),
+            );
+        })
+        .unwrap();
+        let test_window = cx.test_window(window.into());
+        let mut close = test_window.0.lock().should_close_handler.take().unwrap();
+        assert!(close());
+        guarded.set(true);
+        assert!(!close());
+        assert_eq!(calls.get(), 2);
+        assert!(!cx.update(|_| close()));
+        guarded.set(false);
+        assert!(cx.update(|_| close()));
+        assert_eq!(calls.get(), 2);
+        guarded.set(true);
+        cx.update_window(window.into(), |_, window, _| window.remove_window())
+            .unwrap();
+        assert!(!close());
+        assert_eq!(calls.get(), 2);
+        guarded.set(false);
+        assert!(close());
+
+        let window = cx.add_window(|_, _| EmptyView);
+        cx.update_window(window.into(), |_, window, cx| {
+            window.on_window_should_close(cx, |_, _| false);
+        })
+        .unwrap();
+        let test_window = cx.test_window(window.into());
+        let mut close = test_window.0.lock().should_close_handler.take().unwrap();
+        assert!(!close());
+        cx.update_window(window.into(), |_, window, _| window.remove_window())
+            .unwrap();
+        assert!(close());
+    }
+
