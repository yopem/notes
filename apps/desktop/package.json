{
  "name": "@still-notes/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/app.tsx",
    "start": "bun src/app.tsx",
    "build": "bun scripts/build.ts",
    "build:native": "bun scripts/build-native.ts",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
    "format:check": "bun fmt --no-script --check",
    "format:write": "bun fmt --no-script",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "test:store": "bun test tests/store.test.ts",
    "test:native": "bun scripts/native-e2e.ts"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@still-notes/env": "workspace:*",
    "@still-notes/notes": "workspace:*",
    "date-fns": "4.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-markdown": "2.2.2",
    "micromark-util-decode-string": "2.0.1",
    "react": "19.2.0",
    "unist-util-visit": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0"
  }
}
