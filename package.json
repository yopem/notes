{
  "name": "still-notes",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "STILL_NOTES_LAUNCH_DIRECTORY=\"$(pwd)\" turbo run dev --filter=@still-notes/desktop",
    "start": "STILL_NOTES_LAUNCH_DIRECTORY=\"$(pwd)\" bun run --filter @still-notes/desktop start",
    "build": "turbo run build --filter=@still-notes/desktop",
    "build:native": "bun run --filter @still-notes/desktop build:native",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format:check": "turbo run format:check && bun fmt --no-script --check package.json tsconfig.json turbo.json bun-toolchain.json bunfig.toml README.md QA.md LICENSE.md",
    "format:write": "turbo run format:write && bun fmt --no-script package.json tsconfig.json turbo.json bun-toolchain.json bunfig.toml README.md QA.md LICENSE.md",
    "typecheck": "turbo run typecheck",
    "test:store": "bun run --filter @still-notes/desktop test:store",
    "test:native": "bun run --filter @still-notes/desktop test:native"
  },
  "devDependencies": {
    "@yopem/eslint-plugin": "0.1.0",
    "@yopem/oxfmt-config": "0.0.11",
    "@yopem/oxlint-config": "0.7.1",
    "@yopem/typescript-config": "0.2.5",
    "bun": "1.4.4-canary.20261104.1",
    "eslint-plugin-oxfmt": "0.26.0",
    "turbo": "2.11.10"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4-canary.20261104.1",
  "trustedDependencies": [
    "bun"
  ]
}
